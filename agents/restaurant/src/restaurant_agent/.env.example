FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.6-luna"
WAITER_MAX_TURNS="20"
MEMORY_DATABASE_PATH="./data/memory.db"
MEMORY_MAX_ITEMS="20"
APP_ENVIRONMENT="development"
ENABLE_DEV_FAKE_IDENTITY="false"
DEV_FAKE_ACTOR_ID="Cliente local"
SEATING_MCP_URL="http://localhost:8080/mcp"
SEATING_MCP_TIMEOUT_SECONDS="5"
# Optional Foundry IQ knowledge base; scripts/provision-knowledge.sh prints both
# values. Uncomment them together to give the waiter the carta tool.
# AZURE_SEARCH_ENDPOINT="https://<search-service>.search.windows.net"
# KNOWLEDGE_BASE_NAME="conocimiento-restaurante"
# KNOWLEDGE_BASE_TIMEOUT_SECONDS="20"
# External A2A kitchen. Without its URL, pedir_a_cocina returns an explicit
# configuration failure. The token scope is optional for an unauthenticated
# internal endpoint.
# KITCHEN_A2A_URL="http://localhost:8089"
# KITCHEN_A2A_TOKEN_SCOPE=""
# KITCHEN_TIMEOUT_SECONDS="30"
# External A2A cashier. Without its URL, pedir_la_cuenta returns an explicit
# configuration failure.
# CASHIER_A2A_URL="http://localhost:8090"
# CASHIER_A2A_TOKEN_SCOPE=""
# CASHIER_TIMEOUT_SECONDS="30"
# Choose one Azure authentication mechanism for a container. Do not commit secrets.
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""