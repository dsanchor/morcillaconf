# Used by BuildKit for apps/frontend/Dockerfile only; the context is the
# repository root. Allowlist: exclude everything, then re-include what the
# image needs.
*

!packages/contracts/pyproject.toml
!packages/contracts/src/
!apps/frontend/pyproject.toml
!apps/frontend/uv.lock
!apps/frontend/.streamlit/
!apps/frontend/src/

# Never ship local state, secrets or build leftovers from the re-included paths.
**/.env
**/.env.*
**/.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/build
**/dist
