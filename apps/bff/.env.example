# Copia este fichero como apps/bff/.env o exporta las variables.

# Agente independiente por Responses 2.0.
WAITER_AGENT_URL="http://127.0.0.1:8088"
WAITER_AGENT_TIMEOUT_SECONDS="60"

# Estado del BFF (sesiones, visitas, eventos, resultados) y memoria del camarero.
BFF_DATABASE_PATH="./data/bff.db"
MEMORY_DATABASE_PATH="./data/memory.db"
BFF_SQLITE_JOURNAL_MODE="WAL"
MEMORY_MAX_ITEMS="20"
WAITER_MAX_TURNS="20"
APP_ENVIRONMENT="development"

BFF_SESSION_TTL_HOURS="12"
BFF_EVENT_RETENTION="500"
BFF_SSE_HEARTBEAT_SECONDS="15"
