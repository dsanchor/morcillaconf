# Copia este fichero como apps/bff/.env o exporta las variables. Sin secretos:
# la autenticación con Foundry usa DefaultAzureCredential (az login o identidad
# administrada).

# foundry: camarero real con Microsoft Foundry. scripted: camarero simulado
# determinista, sin llamadas al modelo (pruebas, CI y desarrollo sin conexión).
BFF_WAITER="foundry"

# Solo con BFF_WAITER=foundry. Ejemplo de formato, no un valor por defecto.
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.6-luna"

# Estado del BFF (sesiones, visitas, eventos, resultados) y memoria del camarero.
BFF_DATABASE_PATH="./data/bff.db"
MEMORY_DATABASE_PATH="./data/memory.db"
MEMORY_MAX_ITEMS="20"
WAITER_MAX_TURNS="20"
APP_ENVIRONMENT="development"

BFF_SESSION_TTL_HOURS="12"
BFF_EVENT_RETENTION="500"
BFF_SSE_HEARTBEAT_SECONDS="15"
BFF_SCRIPTED_DELAY_SECONDS="0"
