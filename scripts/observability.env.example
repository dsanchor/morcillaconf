# Copy this file outside version control, replace every placeholder, and run:
#   ./scripts/provision-observability.sh path/to/observability.env
#
# Creates a workspace-based Application Insights resource for direct
# OpenTelemetry trace export. The active Azure CLI session provides
# authentication; this file contains no credentials.

AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
OBSERVABILITY_RESOURCE_GROUP="rg-morcillaconf-demo"
OBSERVABILITY_LOCATION="spaincentral"

LOG_ANALYTICS_WORKSPACE_NAME="log-morcillaconf-demo"
LOG_ANALYTICS_RETENTION_DAYS="30"
APPLICATIONINSIGHTS_NAME="appi-morcillaconf-demo"
