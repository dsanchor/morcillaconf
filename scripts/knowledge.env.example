# Copy this file outside version control, replace every placeholder, and run:
#   ./scripts/provision-knowledge.sh path/to/knowledge.env
#
# Creates or updates the Foundry IQ knowledge layer: a storage account with the
# carta and the recipe book, an Azure AI Search service with the recipe index,
# three knowledge sources and the knowledge base. The resource group and the
# Foundry project are prerequisites. This file contains no credentials: the
# active Azure CLI session is used.

AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
KNOWLEDGE_RESOURCE_GROUP="rg-morcillaconf-demo"
# A region with agentic retrieval and the semantic ranker, such as swedencentral.
KNOWLEDGE_LOCATION="swedencentral"

# Globally unique names. Basic or higher: the free tier has no managed identity.
AZURE_SEARCH_SERVICE_NAME="srch-morcillaconf-demo"
AZURE_SEARCH_SKU="basic"
STORAGE_ACCOUNT_NAME="stmorcillaconfdemo"

# The same Foundry project as in container-apps.env. The knowledge base uses
# one of its chat deployments to plan queries and summarize web results.
FOUNDRY_PROJECT_RESOURCE_ID="/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry/providers/Microsoft.CognitiveServices/accounts/my-foundry/projects/my-project"
KNOWLEDGE_BASE_MODEL_DEPLOYMENT="gpt-4.1-mini"

KNOWLEDGE_BASE_NAME="conocimiento-restaurante"

# Optional: the waiter's managed identity gets Search Index Data Reader now.
# deploy-container-apps.sh also grants it when the knowledge base is configured.
AGENT_IDENTITY_NAME=""
AGENT_IDENTITY_RESOURCE_GROUP=""
