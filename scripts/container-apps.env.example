# Copy this file outside version control, replace every placeholder, and run:
#   ./scripts/deploy-container-apps.sh path/to/container-apps.env
#
# This file contains deployment configuration but no credentials. Authentication
# is provided by the active Azure CLI session. The restaurant and kitchen
# agents use the managed identity created by the script to access Foundry and,
# when configured, the knowledge base.

AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_LOCATION="spaincentral"
AZURE_RESOURCE_GROUP="rg-morcillaconf-demo"

MANAGED_IDENTITY_NAME="id-morcillaconf-demo"
CONTAINERAPPS_ENVIRONMENT="cae-morcillaconf-demo"

FRONTEND_APP_NAME="morcilla-frontend"
BFF_APP_NAME="morcilla-bff"
RESTAURANT_AGENT_APP_NAME="morcilla-agent"
KITCHEN_AGENT_APP_NAME="morcilla-kitchen"
MCP_APP_NAME="morcilla-mcp"

# Images must be public. Prefer ghcr.io/owner/image@sha256:<64-hex-digest>;
# immutable commit-SHA tags published by this repository's workflows also work.
FRONTEND_IMAGE="ghcr.io/replace-owner/morcillaconf-frontend:replace-with-git-sha"
BFF_IMAGE="ghcr.io/replace-owner/morcillaconf-bff:replace-with-git-sha"
RESTAURANT_AGENT_IMAGE="ghcr.io/replace-owner/morcillaconf-restaurant-agent:replace-with-git-sha"
KITCHEN_AGENT_IMAGE="ghcr.io/replace-owner/morcillaconf-kitchen-agent:replace-with-git-sha"
MCP_IMAGE="ghcr.io/replace-owner/morcillaconf-mcp:replace-with-git-sha"

FOUNDRY_PROJECT_RESOURCE_ID="/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry/providers/Microsoft.CognitiveServices/accounts/my-foundry/projects/my-project"
FOUNDRY_PROJECT_ENDPOINT="https://my-foundry.services.ai.azure.com/api/projects/my-project"
AZURE_AI_MODEL_DEPLOYMENT_NAME="replace-with-model-deployment"

# Optional: the Foundry IQ knowledge base created by provision-knowledge.sh,
# which prints these values. Set the first three together or leave them empty
# to deploy the waiter without the carta. The agent identity gets Search Index
# Data Reader on the search service.
AZURE_SEARCH_RESOURCE_ID=""
AZURE_SEARCH_ENDPOINT=""
KNOWLEDGE_BASE_NAME=""
KNOWLEDGE_BASE_TIMEOUT_SECONDS="20"

# The external kitchen uses the same Foundry project and model deployment. Its
# A2A endpoint is created by the deployment script and injected into the waiter.
# The timeout bounds the complete A2A call and kitchen orchestration; keep it at
# least 20 s under WAITER_AGENT_TIMEOUT_SECONDS.
KITCHEN_TIMEOUT_SECONDS="60"

MEMORY_MAX_ITEMS="20"
WAITER_MAX_TURNS="20"
WAITER_AGENT_TIMEOUT_SECONDS="90"
BFF_SESSION_TTL_HOURS="12"
BFF_EVENT_RETENTION="500"
BFF_SSE_HEARTBEAT_SECONDS="15"
# Seconds cooked dishes wait at the pass before the waiter serves them.
BFF_SERVE_DELAY_SECONDS="15"
# Only the restaurant agent talks to the seating MCP.
SEATING_MCP_TIMEOUT_SECONDS="5"

SEATING_LAYOUT_ID="morcillaconf-demo-v1"
SEATING_LAYOUT_FILE="services/mcp/layouts/morcillaconf-demo-v1.json"
SEATING_HOLD_MINUTES="5"
